rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function userProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isSuperAdmin() { return userProfile().role == 'superadmin'; }
    function isAdmin() { return userProfile().role in ['admin', 'superadmin']; }
    function sameAirport(airportCode) { return userProfile().airportCode == airportCode; }

    // Users collection
    match /users/{uid} {
      allow read: if isAuth() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuth() && isAdmin();
      allow update: if isAuth() && (request.auth.uid == uid || isAdmin());
    }

    // Airport data — extinguishers and reports
    match /airports/{airportCode}/{document=**} {
      allow read: if isAuth() && (isSuperAdmin() || sameAirport(airportCode));
      allow write: if isAuth() && (isSuperAdmin() || sameAirport(airportCode));
    }
  }
}
